# Copy to .env and edit. Never commit .env.

# ── LLM (cloud-first; Ollama optional/local fallback) ──────────────────────
LLM_PROVIDER=cloud             # cloud | ollama (cloud recommended/default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Primary cloud provider (OpenAI-compatible endpoint; OpenRouter supported)
CLOUD_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL=nvidia/nemotron-3.5-lightning:free
CLOUD_API_KEY=
# Optional: request/response controls
LLM_TIMEOUT_SECONDS=120
# Future-ready provider settings (placeholders for multi-provider manager)
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# ── PostgreSQL (required for auth/RBAC persistence) ────────────────────────
# Example local dev (pgAdmin 4): postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/opspilot_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/opspilot_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Auth / Security ────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_COOKIE_NAME=opspilot_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Bootstrap Super Admin (one-time, disable after creation) ───────────────
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=OpsPilot Super Admin

# ── OAuth (optional, configure for social login) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback

FRONTEND_BASE_URL=http://localhost:5173
APP_ENV=development
