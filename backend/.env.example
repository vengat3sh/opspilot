# Copy to .env and edit. Never commit .env.
LLM_PROVIDER=ollama            # ollama | cloud
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Cloud (Zero-cost verified OpenRouter free tier)
CLOUD_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL=nvidia/nemotron-3.5-lightning:free
CLOUD_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
